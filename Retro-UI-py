LIVE_LOG_LINES = 5
def get_log_color(entry):
    if entry["source"] == "DU":
        return curses.color_pair(5)
    if entry["source"] == "HA":
        return curses.color_pair(7)
    if entry["level"] == "error":
        return curses.color_pair(6)
    return curses.color_pair(3)
def filter_log_entries_for_mode(entries):
    mode = config.get("log_mode", "C")
    if mode == "A":
        return [e for e in entries if e["source"] == "DU"]
    elif mode == "B":
        return [e for e in entries if e["source"] != "DU"]
    else:
        return entries
def draw_live_log(stdscr):
    h, w = stdscr.getmaxyx()
    bottom = h - 2
    top = bottom - LIVE_LOG_LINES
    if top <= 4:
        return
    draw_box(stdscr, top, 0, bottom, w - 1, " Live logg ", 1)
    with log_lock:
        entries = list(log_buffer)
    entries = filter_log_entries_for_mode(entries)
    entries = entries[-LIVE_LOG_LINES:]
    y = top + 1
    for e in entries:
        line = f"{e['time']}  [{e['source']}] {e['message']}"
        color = get_log_color(e)
        stdscr.attron(color)
        safe_addstr(stdscr, y, 2, line[: max(1, w - 4)])
        stdscr.attroff(color)
        y += 1
        if y >= bottom:
            break
