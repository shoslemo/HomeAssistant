            safe_addstr(stdscr, y + height, x + 1, "▒" * width)
            stdscr.attroff(curses.color_pair(4))

            safe_addstr(stdscr, y + 2, x + 2, prompt[: width - 4])
            visible_value = buffer[-(width - 6):]
            safe_addstr(stdscr, y + 3, x + 2, (" " * (width - 4)))
            safe_addstr(stdscr, y + 3, x + 2, visible_value)
            safe_addstr(stdscr, y + 5, x + 2, "Enter: OK  |  ESC: avbryt  |  Backspace: slett", curses.A_DIM)

            cursor_x = min(x + 2 + len(visible_value), x + width - 3)
            cursor_y = y + 3

            try:
                curses.curs_set(1)
            except Exception:
                pass

            stdscr.move(cursor_y, cursor_x)
            stdscr.refresh()

            key = stdscr.getch()

            if key == 27:  # ESC
                try:
                    curses.curs_set(0)
                except Exception:
                    pass
                return None

            elif key in (10, 13):  # Enter
                try:
                    curses.curs_set(0)
                except Exception:
                    pass
                return buffer.strip()

            elif key in (curses.KEY_BACKSPACE, 127, 8):
                buffer = buffer[:-1]

            elif 32 <= key <= 126:
                if len(buffer) < max_len:
                    buffer += chr(key)
    finally:
        # Restore the original timeout setting
        stdscr.timeout(old_timeout)

def search_prompt(stdscr):
    return input_popup(
        stdscr,
        "Søk",
        "Søk (entity_id / navn):",
        initial_value="",
        max_len=60,
    )


def title_prompt(stdscr):
    value = input_popup(
        stdscr,
        "Tittel",
        "Ny tittel:",
        initial_value=config.get("title", ""),
        max_len=80,
    )
    if value:
        config["title"] = value

def theme_menu(stdscr):
    items = list(THEMES.keys())
    choice = list_popup(stdscr, "Velg tema", items)
    if choice:
        config["theme"] = choice
def view_state_style_menu(stdscr):
    items = [
        "Entiteter: kun høyrejustert",
        "Entiteter: høyrejustert + farge",
        "Detaljer: kun høyrejustert",
        "Detaljer: høyrejustert + farge",
    ]
    choice = list_popup(stdscr, "State-stil", items)
    if not choice:
        return
    if choice.startswith("Entiteter") and "farge" in choice:
        config["state_color_entities"] = "colored"
    elif choice.startswith("Entiteter"):
        config["state_color_entities"] = "plain"
    elif choice.startswith("Detaljer") and "farge" in choice:
        config["state_color_details"] = "colored"
    else:
        config["state_color_details"] = "plain"
def log_mode_menu(stdscr):
    items = [
        "A: Kun dine handlinger",
        "B: Alle HA-endringer",
        "C: Begge, med fargekoding",
    ]
    choice = list_popup(stdscr, "Logg-modus", items)
    if not choice:
        return
    if choice.startswith("A"):
        config["log_mode"] = "A"
    elif choice.startswith("B"):
        config["log_mode"] = "B"
    elif choice.startswith("C"):
        config["log_mode"] = "C"
def execute_menu_choice(stdscr, active_menu_index):
    label = MENU_LABELS[active_menu_index]

    if label == "Tema":
        theme_menu(stdscr)

    elif label == "Visning":
        view_state_style_menu(stdscr)

    elif label == "Logg":
        log_mode_menu(stdscr)

    elif label == "Scener":
        # Kan utvides senere med egen scene-popup
        pass

    elif label == "Lys":
        # Behandles i main ved å velge riktig domain
        return "domain:light"

    elif label == "Switches":
        return "domain:switch"

    elif label == "Sensorer":
        return "domain:sensor"

    return None

# =========================
# MAIN-LOOP
# =========================
def main(stdscr):
    curses.curs_set(0)
    curses.start_color()
    curses.use_default_colors()

    load_config()
    apply_theme(stdscr, config["theme"])

    ha_ok_states = ha_get_states()

    try:
        ha_ok_areas = ha_get_areas()
        if ha_ok_areas:
            build_area_entity_map()
    except Exception as e:
        ha_ok_areas = False
        add_log_entry("ERR", f"Area-oppsett feilet: {e}", level="error")

    ha_ok = ha_ok_states

    start_websocket_thread()

    selected_area_index = 0
    selected_domain_index = 0
    selected_entity_index = 0

    # 0=areas, 1=domener, 2=enheter, 3=detaljer, 4=meny
    active_panel = 2
    active_menu_index = 0

    view_mode = config.get("last_view_mode", "domain")
    search_term = ""
    favorites_list = config.get("favorites", [])

    stdscr.timeout(250)

    while True:
        current_entities = []
        current_entity = None

        try:
            stdscr.erase()
            apply_theme(stdscr, config["theme"])

            draw_header(stdscr)

            if active_panel == 4:
                draw_menu_bar(stdscr, active_menu_index, "menu")
            else:
                draw_menu_bar(stdscr, active_menu_index, "normal")

            current_entities, current_entity, selected_entity_index = draw_main_panels(
                stdscr,
                selected_area_index,
                selected_domain_index,
                selected_entity_index,
                active_panel,
                view_mode,
                search_term,
                favorites_list,
            )

            draw_live_log(stdscr)
            draw_status(stdscr, ha_ok, view_mode, config["theme"])

            stdscr.refresh()

        except curses.error:
            time.sleep(0.05)

        key = stdscr.getch()

        if key == -1:
            continue

        if key == ord("q") or key == curses.KEY_F10:
            break

        elif key == curses.KEY_F2 or key == ord("d"):
            view_mode = "favorites" if view_mode != "favorites" else "domain"
            selected_entity_index = 0

        elif key == ord("s"):
            result = search_prompt(stdscr)

            # ESC -> avbryt, behold nåværende view
            if result is None:
                pass

            # Tomt søk -> nullstill søk og gå tilbake til normal domain-visning
            elif result.strip() == "":
                search_term = ""
                view_mode = "domain"
                selected_entity_index = 0
                add_log_entry("DU", "Nullstilte søk")

            # Faktisk søketekst -> search mode
            else:
                search_term = result.strip()
                view_mode = "search"
                selected_entity_index = 0
                add_log_entry("DU", f"Søk: {search_term}")

        elif key == ord("c"):
            if view_mode == "search":
                search_term = ""
                view_mode = "domain"
                selected_entity_index = 0
                add_log_entry("DU", "Nullstilte søk")


        elif key == ord("f"):
            if current_entity:
                eid = current_entity["entity_id"]
                if eid in favorites_list:
                    favorites_list.remove(eid)
                    add_log_entry("DU", f"Fjernet favoritt: {eid}")
                else:
                    favorites_list.append(eid)
                    add_log_entry("DU", f"La til favoritt: {eid}")
                config["favorites"] = favorites_list

        elif key == ord("t"):
            title_prompt(stdscr)

        elif key == ord("l"):
            draw_log_popup(stdscr)

        elif key == ord("r"):
            ha_ok_states = ha_get_states()
            try:
                ha_ok_areas = ha_get_areas()
                if ha_ok_areas:
                    build_area_entity_map()
            except Exception as e:
                ha_ok_areas = False
                add_log_entry("ERR", f"Refresh av areas feilet: {e}", level="error")
            ha_ok = ha_ok_states
            add_log_entry("DU", "Manuell refresh av states/areas")

        elif key == ord("m"):
            choice = list_popup(stdscr, "Meny", ["Tema", "Visning", "Logg", "Scripts", "Automations"])
            if choice == "Tema":
                theme_menu(stdscr)
            elif choice == "Visning":
                view_state_style_menu(stdscr)
            elif choice == "Logg":
                log_mode_menu(stdscr)
            elif choice == "Scripts":
                scripts_popup(stdscr)
            elif choice == "Automations":
                automations_popup(stdscr)

        elif key == 9:
            active_panel = (active_panel + 1) % 5

        elif key == 353:
            active_panel = (active_panel - 1) % 5

        elif key == curses.KEY_UP:
            if active_panel == 0:
                selected_area_index = max(0, selected_area_index - 1)
                selected_entity_index = 0
            elif active_panel == 1:
                selected_domain_index = max(0, selected_domain_index - 1)
                selected_entity_index = 0
            elif active_panel == 2:
                selected_entity_index = max(0, selected_entity_index - 1)

        elif key == curses.KEY_DOWN:
            if active_panel == 0:
                areas_with_all = get_areas_with_all()
                selected_area_index = min(len(areas_with_all) - 1, selected_area_index + 1) if areas_with_all else 0
                selected_entity_index = 0
            elif active_panel == 1:
                selected_domain_index = min(len(DOMAINS) - 1, selected_domain_index + 1)
                selected_entity_index = 0
            elif active_panel == 2 and current_entities:
                selected_entity_index = min(len(current_entities) - 1, selected_entity_index + 1)

        elif key == curses.KEY_LEFT:
            if active_panel == 4:
                active_menu_index = max(0, active_menu_index - 1)
            elif active_panel > 0:
                active_panel -= 1

        elif key == curses.KEY_RIGHT:
            if active_panel == 4:
                active_menu_index = min(len(MENU_LABELS) - 1, active_menu_index + 1)
            elif active_panel < 4:
                active_panel += 1

        elif key in (10, 13) and active_panel == 4:
            label = MENU_LABELS[active_menu_index]

            if label == "Tema":
                theme_menu(stdscr)

            elif label == "Visning":
                view_state_style_menu(stdscr)

            elif label == "Logg":
                log_mode_menu(stdscr)

            elif label == "Lys":
                view_mode = "domain"
                if "light" in DOMAINS:
                    selected_domain_index = DOMAINS.index("light")
                selected_entity_index = 0

            elif label == "Switches":
                view_mode = "domain"
                if "switch" in DOMAINS:
                    selected_domain_index = DOMAINS.index("switch")
                selected_entity_index = 0

            elif label == "Sensorer":
                view_mode = "domain"
                if "sensor" in DOMAINS:
                    selected_domain_index = DOMAINS.index("sensor")
                selected_entity_index = 0

            elif label == "Scener":
                view_mode = "domain"
                if "scene" in DOMAINS:
                    selected_domain_index = DOMAINS.index("scene")
                selected_entity_index = 0

        elif key in (10, 13):
            if active_panel in (2, 3) and current_entity:
                popup_entity(stdscr, current_entity)
                ha_get_states()

        elif key == ord(" "):
            if current_entity:
                ha_toggle(current_entity)
                ha_get_states()

        elif key == curses.KEY_F1:
            if view_mode == "domain":
                view_mode = "favorites"
            elif view_mode == "favorites":
                view_mode = "search"
            else:
                view_mode = "domain"

        config["last_view_mode"] = view_mode

    save_config()


if __name__ == "__main__":
    curses.wrapper(main)
