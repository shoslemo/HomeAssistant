def compute_columns(stdscr):
    h, w = stdscr.getmaxyx()
    total = max(10, w - 4)
    col_area = max(14, int(total * 0.15))
    col_domain = max(14, int(total * 0.15))
    col_entities = max(30, int(total * 0.40))
    col_details = total - (col_area + col_domain + col_entities)
    if col_details < 20:
        col_details = 20
    return col_area, col_domain, col_entities, col_details
def format_entity_line(e, width):
    eid = e["entity_id"]
    state = e["state"]
    attrs = e.get("attributes", {})
    name = attrs.get("friendly_name", eid)
    state_str = f"[{state}]"
    max_name_width = max(5, width - len(state_str) - 2)
    name_part = str(name)[:max_name_width]
    padding = width - len(name_part) - len(state_str)
    if padding < 1:
        padding = 1
    line = name_part + (" " * padding) + state_str
    return line[:width]
def get_state_color(state):
    if state in ("on", "playing", "open", "opening", "home"):
        return curses.color_pair(5)
    if state in ("off", "paused", "closed", "closing", "not_home"):
        return curses.color_pair(1)
    if state in ("unavailable", "unknown"):
        return curses.color_pair(6)
    return curses.color_pair(1)
