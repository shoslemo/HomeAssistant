def build_area_entity_map():
    global area_entity_map
    area_entity_map = {}

    entity_reg = ha_get_entity_registry()
    device_reg = ha_get_device_registry()

    if not entity_reg or not device_reg:
        add_log_entry("ERR", "Kunne ikke bygge area/entity-map", level="warn")
        return

    devices_by_id = {d.get("id"): d for d in device_reg if d.get("id")}

    for e in entity_reg:
        eid = e.get("entity_id")
        if not eid:
            continue

        area_id = e.get("area_id")

        if not area_id:
            dev_id = e.get("device_id")
            if dev_id:
                dev = devices_by_id.get(dev_id)
                if dev:
                    area_id = dev.get("area_id")

        if not area_id:
            continue

        area_entity_map.setdefault(area_id, []).append(eid)

def get_areas_with_all():
    """Returner områder med 'Alle' som første element"""
    all_entry = {"area_id": None, "name": "Alle"}
    return [all_entry] + areas


def filter_entities_by_area_and_domain(area_id, domain):
    result = []
    if area_id is None:
        # "Alle" - returner alle entities i dette domenet
        return [e for e in entities if e["entity_id"].startswith(domain + ".")]
    
    for eid in area_entity_map.get(area_id, []):
        if not eid.startswith(domain + "."):
            continue
        st = entity_by_id.get(eid)
        if st:
            result.append(st)
    return result


def count_entities_in_area(area_id):
    if area_id is None:
        # "Alle" - returner totalt antall entities
        return len(entities)
    return len(area_entity_map.get(area_id, []))
