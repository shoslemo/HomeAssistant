def ha_get_states():
    global entities, entity_by_id
    try:
        r = requests.get(f"{HA_URL}/api/states", headers=headers, timeout=5)
        r.raise_for_status()
        data = r.json()
        with entities_lock:
            entities = data
            entity_by_id = {e["entity_id"]: e for e in entities}
        return True
    except Exception as e:
        add_log_entry("ERR", f"Feil ved henting av states: {e}", level="error")
        return False
