def ha_call_service(domain, service, data):
    url = f"{HA_URL}/api/services/{domain}/{service}"
    try:
        requests.post(url, headers=headers, data=json.dumps(data), timeout=5)
    except Exception as e:
        add_log_entry("ERR", f"Feil ved kall til {domain}.{service}: {e}", level="error")
def ha_toggle(entity):
    entity_id = entity["entity_id"]
    domain = entity_id.split(".")[0]
    state = entity["state"]
    if domain == "script":
        ha_call_service("script", "turn_on", {"entity_id": entity_id})
        add_log_entry("DU", f"{entity_id} → script.turn_on")
        return
    if domain == "automation":
        if state == "on":
            ha_call_service("automation", "turn_off", {"entity_id": entity_id})
            add_log_entry("DU", f"{entity_id} → automation.turn_off")
        else:
            ha_call_service("automation", "turn_on", {"entity_id": entity_id})
            add_log_entry("DU", f"{entity_id} → automation.turn_on")
        return
    if domain == "scene":
        ha_call_service("scene", "turn_on", {"entity_id": entity_id})
        add_log_entry("DU", f"{entity_id} → scene.turn_on")
    elif domain in ("light", "switch", "input_boolean", "media_player", "cover"):
        if domain == "input_boolean":
            ha_call_service("input_boolean", "toggle", {"entity_id": entity_id})
            add_log_entry("DU", f"{entity_id} → toggle")
        elif domain == "media_player":
            if state == "playing":
                ha_call_service("media_player", "media_pause", {"entity_id": entity_id})
                add_log_entry("DU", f"{entity_id} → media_pause")
            else:
                ha_call_service("media_player", "media_play", {"entity_id": entity_id})
                add_log_entry("DU", f"{entity_id} → media_play")
        elif domain == "cover":
            if state in ("open", "opening"):
                ha_call_service("cover", "close_cover", {"entity_id": entity_id})
                add_log_entry("DU", f"{entity_id} → close_cover")
            else:
                ha_call_service("cover", "open_cover", {"entity_id": entity_id})
                add_log_entry("DU", f"{entity_id} → open_cover")
        else:
            service = "turn_off" if state == "on" else "turn_on"
            ha_call_service(domain, service, {"entity_id": entity_id})
            add_log_entry("DU", f"{entity_id} → {service}")
