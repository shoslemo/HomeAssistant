def ha_ws_call(msg_type, msg_id=1):
    url = HA_URL.replace("http://", "ws://").replace("https://", "wss://") + "/api/websocket"
    ws = None
    try:
        ws = websocket.create_connection(url, timeout=2)
        ws.settimeout(2)

        raw = ws.recv()
        data = json.loads(raw)

        if data.get("type") == "auth_required":
            ws.send(json.dumps({"type": "auth", "access_token": TOKEN}))
            data = json.loads(ws.recv())
            if data.get("type") != "auth_ok":
                add_log_entry("ERR", f"WS auth feilet for {msg_type}", level="error")
                return None

        ws.send(json.dumps({"id": msg_id, "type": msg_type}))
        resp = json.loads(ws.recv())

        if resp.get("success", False):
            return resp.get("result", [])

        add_log_entry("ERR", f"WS-kall {msg_type} feilet", level="error")
        return None

    except Exception as e:
        add_log_entry("ERR", f"WS-kall {msg_type} timeout/feil: {e}", level="error")
        return None

    finally:
        try:
            if ws:
                ws.close()
        except Exception:
            pass

def ha_get_areas():
