def draw_log_popup(stdscr):
    h, w = stdscr.getmaxyx()
    width = min(w - 10, 120)
    height = min(h - 6, 30)
    x = (w - width) // 2
    y = (h - height) // 2
    with log_lock:
        entries = list(log_buffer)
    entries = filter_log_entries_for_mode(entries)
    scroll = 0
    max_scroll = max(0, len(entries) - (height - 4))

    # Save the current timeout setting and disable timeout for this popup
    old_timeout = stdscr.gettimeout() if hasattr(stdscr, 'gettimeout') else 250
    stdscr.timeout(-1)  # Blocking mode: wait indefinitely for input

    try:
        while True:
            stdscr.attron(curses.color_pair(2))
            for yy in range(y, y + height):
                safe_addstr(stdscr, yy, x, " " * width)
            stdscr.attroff(curses.color_pair(2))
            draw_box(stdscr, y, x, y + height - 1, x + width - 1, " Logg (ESC for å lukke) ", 2)
            stdscr.attron(curses.color_pair(4))
            for yy in range(y + 1, y + height + 1):
                safe_addstr(stdscr, yy, x + width, "▒")
            safe_addstr(stdscr, y + height, x + 1, "▒" * width)
            stdscr.attroff(curses.color_pair(4))
            visible = entries[scroll:scroll + (height - 4)]
            row = y + 2
            for e in visible:
                line = f"{e['time']}  [{e['source']}] {e['message']}"
                color = get_log_color(e)
                stdscr.attron(color)
                safe_addstr(stdscr, row, x + 2, line[: width - 4])
                stdscr.attroff(color)
                row += 1
            if max_scroll > 0:
                bar_height = max(1, int((height - 4) * (height - 4) / len(entries)))
                bar_pos = int((height - 4 - bar_height) * (scroll / max_scroll))
                for i in range(height - 4):
                    ch = "│"
                    if i >= bar_pos and i < bar_pos + bar_height:
                        ch = "█"
                    safe_addstr(stdscr, y + 2 + i, x + width - 2, ch)
            stdscr.refresh()
            key = stdscr.getch()
            if key == 27:
                break
            elif key == curses.KEY_UP:
                scroll = max(0, scroll - 1)
            elif key == curses.KEY_DOWN:
                scroll = min(max_scroll, scroll + 1)
            elif key == curses.KEY_PPAGE:
                scroll = max(0, scroll - (height - 4))
            elif key == curses.KEY_NPAGE:
                scroll = min(max_scroll, scroll + (height - 4))
    finally:
        # Restore the original timeout setting
        stdscr.timeout(old_timeout)
