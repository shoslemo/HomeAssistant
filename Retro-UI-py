            max_value_width = 5
        value_str = value[:max_value_width]
        padding = width - len(key_str) - len(value_str) - 2
        if padding < 1:
            padding = 1
        line = key_str + (" " * padding) + value_str
        if key == "State" and config["state_color_details"] == "colored":
            attr = get_state_color(state)
        else:
            attr = 0
        safe_addstr(stdscr, y, x_start + 1, line[: width - 2], attr)
