def list_popup(stdscr, title, items):
    if not items:
        return None
    h, w = stdscr.getmaxyx()
    max_item_len = max(len(str(i)) for i in items)
    width = min(w - 10, max_item_len + 6)
    height = min(h - 6, len(items) + 6)
    x = (w - width) // 2
    y = (h - height) // 2
    selected = 0
    max_visible = height - 4

    # Save the current timeout setting and disable timeout for this popup
    old_timeout = stdscr.gettimeout() if hasattr(stdscr, 'gettimeout') else 250
    stdscr.timeout(-1)  # Blocking mode: wait indefinitely for input

    try:
        while True:
            stdscr.attron(curses.color_pair(2))
            for yy in range(y, y + height):
                safe_addstr(stdscr, yy, x, " " * width)
            stdscr.attroff(curses.color_pair(2))
            draw_box(stdscr, y, x, y + height - 1, x + width - 1, f" {title} ", 2)
            stdscr.attron(curses.color_pair(4))
            for yy in range(y + 1, y + height + 1):
                safe_addstr(stdscr, yy, x + width, "▒")
            safe_addstr(stdscr, y + height, x + 1, "▒" * width)
            stdscr.attroff(curses.color_pair(4))
            start = 0
            if selected >= max_visible:
                start = selected - max_visible + 1
            visible = items[start:start + max_visible]
            for i, item in enumerate(visible):
                row = y + 2 + i
                prefix = "> " if start + i == selected else "  "
                attr = curses.color_pair(1) if start + i == selected else 0
                safe_addstr(stdscr, row, x + 2, f"{prefix}{item}".ljust(width - 4), attr)
            stdscr.refresh()
            key = stdscr.getch()
            if key == 27:
                return None
            elif key == curses.KEY_UP:
                selected = max(0, selected - 1)
            elif key == curses.KEY_DOWN:
                selected = min(len(items) - 1, selected + 1)
            elif key in (10, 13):
                return items[selected]
    finally:
        # Restore the original timeout setting
        stdscr.timeout(old_timeout)
