# WEBSOCKET-LOGG (STATE CHANGES)
# =========================
def ws_on_message(ws, message):
    global entities, entity_by_id
    try:
        data = json.loads(message)
    except Exception:
        return
    if data.get("type") == "event":
        event = data.get("event", {})
        if event.get("event_type") == "state_changed":
            ent = event.get("data", {}).get("entity_id")
            new_state = event.get("data", {}).get("new_state")
            if not ent or not new_state:
                return
            state = new_state.get("state")
            with entities_lock:
                entity_by_id[ent] = new_state
                replaced = False
                for i, e in enumerate(entities):
                    if e.get("entity_id") == ent:
                        entities[i] = new_state
                        replaced = True
                        break
                if not replaced:
                    entities.append(new_state)
            add_log_entry("HA", f"{ent} → {state}")
    elif data.get("type") == "auth_required":
        ws.send(json.dumps({"type": "auth", "access_token": TOKEN}))
    elif data.get("type") == "auth_ok":
        ws.send(json.dumps({
            "id": 1,
            "type": "subscribe_events",
            "event_type": "state_changed"
        }))
def ws_on_error(ws, error):
    add_log_entry("ERR", f"WebSocket-feil: {error}", level="error")
def ws_on_close(ws, close_status_code, close_msg):
    add_log_entry("ERR", "WebSocket lukket", level="error")
def ws_on_open(ws):
    pass
def websocket_loop():
    global ws_running
    ws_running = True
    url = HA_URL.replace("http://", "ws://").replace("https://", "wss://") + "/api/websocket"
    while ws_running:
        try:
            ws = websocket.WebSocketApp(
                url,
                on_message=ws_on_message,
                on_error=ws_on_error,
                on_close=ws_on_close,
                on_open=ws_on_open,
            )
            ws.run_forever()
        except Exception as e:
            add_log_entry("ERR", f"WebSocket-tilkobling feilet: {e}", level="error")
        time.sleep(5)
def start_websocket_thread():
    global ws_thread
    if ws_thread is not None:
        return
    t = threading.Thread(target=websocket_loop, daemon=True)
    ws_thread = t
    t.start()
