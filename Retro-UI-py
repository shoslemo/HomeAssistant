def apply_theme(stdscr, theme_name):
    bg, fg = THEMES[theme_name]
    curses.init_pair(1, fg, bg)                    # hovedbakgrunn
    curses.init_pair(2, curses.COLOR_BLACK, fg)    # valgt / popup
    curses.init_pair(3, curses.COLOR_YELLOW, bg)   # header / status
    curses.init_pair(4, curses.COLOR_BLACK, curses.COLOR_BLACK)  # skygge
    curses.init_pair(5, curses.COLOR_GREEN, bg)    # logg / OK / "on"
    curses.init_pair(6, curses.COLOR_RED, bg)      # logg: ERR / unavailable
    curses.init_pair(7, curses.COLOR_CYAN, bg)     # logg: HA / info
    curses.init_pair(8, curses.COLOR_MAGENTA, bg)  # spesial
    stdscr.bkgd(" ", curses.color_pair(1))
def draw_box(stdscr, y1, x1, y2, x2, title=None, color_pair=1):
    h, w = stdscr.getmaxyx()
    y1 = max(0, min(y1, h - 2))
    y2 = max(0, min(y2, h - 2))
    x1 = max(0, min(x1, w - 2))
    x2 = max(0, min(x2, w - 2))
    if y2 <= y1 or x2 <= x1:
        return
    stdscr.attron(curses.color_pair(color_pair))
    for x in range(x1, x2):
        safe_addch(stdscr, y1, x, curses.ACS_HLINE)
        safe_addch(stdscr, y2, x, curses.ACS_HLINE)
    for y in range(y1, y2):
        safe_addch(stdscr, y, x1, curses.ACS_VLINE)
        safe_addch(stdscr, y, x2, curses.ACS_VLINE)
    safe_addch(stdscr, y1, x1, curses.ACS_ULCORNER)
    safe_addch(stdscr, y1, x2, curses.ACS_URCORNER)
    safe_addch(stdscr, y2, x1, curses.ACS_LLCORNER)
    safe_addch(stdscr, y2, x2, curses.ACS_LRCORNER)
    if title:
        safe_addstr(stdscr, y1, x1 + 2, f" {title} ")
    stdscr.attroff(curses.color_pair(color_pair))
def draw_header(stdscr):
    h, w = stdscr.getmaxyx()
    line = "█" * max(1, w - 1)
    stdscr.attron(curses.color_pair(3))
    safe_addstr(stdscr, 0, 0, line)
    safe_addstr(stdscr, 2, 0, line)
    stdscr.attroff(curses.color_pair(3))
    text = f" {config['title']} "
    x = max(0, (w - len(text)) // 2)
    stdscr.attron(curses.color_pair(3))
    safe_addstr(stdscr, 1, 0, " " * max(1, w - 1))
    safe_addstr(stdscr, 1, x, text)
    stdscr.attroff(curses.color_pair(3))
def draw_menu_bar(stdscr, active_menu, mode):
    h, w = stdscr.getmaxyx()

    stdscr.attron(curses.color_pair(3))
    safe_addstr(stdscr, 3, 0, " " * max(1, w - 1))

    x = 2
    for i, label in enumerate(MENU_LABELS):
        text = f" {label} "

        if x >= w - 2:
            break

        if mode == "menu" and i == active_menu:
            stdscr.attron(curses.color_pair(2))
            safe_addstr(stdscr, 3, x, text[: max(0, w - x - 1)])
            stdscr.attroff(curses.color_pair(2))
        else:
            safe_addstr(stdscr, 3, x, text[: max(0, w - x - 1)])

        x += len(text) + 1

    stdscr.attroff(curses.color_pair(3))


