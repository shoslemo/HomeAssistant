    if not entity:
        safe_addstr(stdscr, top + 1, x_start + 2, "Ingen entitet valgt", curses.A_DIM)
        return
    attrs = entity.get("attributes", {})
    lines = []
    eid = entity["entity_id"]
    state = entity["state"]
    name = attrs.get("friendly_name", eid)
    lines.append(("ID", eid))
    lines.append(("Navn", name))
    lines.append(("State", state))
    for k, v in attrs.items():
        if k == "friendly_name":
            continue
        lines.append((k, str(v)))
    max_rows = bottom - top - 1
    y = top + 1
    for key, value in lines[:max_rows]:
        key_str = f"{key}: "
