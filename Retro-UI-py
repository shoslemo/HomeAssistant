def load_config():
    if not os.path.exists(CONFIG_PATH):
        return
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k = k.strip()
                v = v.strip()
                if k == "title":
                    config["title"] = v
                elif k == "theme" and v in THEMES:
                    config["theme"] = v
                elif k == "favorites":
                    if v:
                        config["favorites"] = [x.strip() for x in v.split(",") if x.strip()]
                elif k == "log_mode" and v in LOG_MODE_OPTIONS:
                    config["log_mode"] = v
                elif k == "state_color_entities" and v in ("plain", "colored"):
                    config["state_color_entities"] = v
                elif k == "state_color_details" and v in ("plain", "colored"):
                    config["state_color_details"] = v
                elif k == "last_view_mode" and v in ("domain", "favorites", "search"):
                    config["last_view_mode"] = v
    except Exception:
        pass
def save_config():
    try:
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            f.write(f"title={config['title']}\n")
            f.write(f"theme={config['theme']}\n")
            f.write("favorites=" + ",".join(config["favorites"]) + "\n")
            f.write(f"log_mode={config['log_mode']}\n")
            f.write(f"state_color_entities={config['state_color_entities']}\n")
            f.write(f"state_color_details={config['state_color_details']}\n")
            f.write(f"last_view_mode={config['last_view_mode']}\n")
    except Exception:
        pass
